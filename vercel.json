{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-rcGAGZ3LarR9Gq4EJ0BErje+zWTEhFmKbcrEdWFU4O8=' https://www.gstatic.com https://unpkg.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://*.firebaseapp.com https://*.web.app https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/bancos", "destination": "/pages/bancos.html" },
    { "source": "/categorias", "destination": "/pages/categorias.html" },
    { "source": "/receitas", "destination": "/pages/receitas.html" },
    { "source": "/despesas", "destination": "/pages/despesas.html" },
    { "source": "/transferencias", "destination": "/pages/transferencias.html" },
    { "source": "/orcamentos", "destination": "/pages/orcamentos.html" },
    { "source": "/assinaturas", "destination": "/pages/assinaturas.html" },
    { "source": "/devedores", "destination": "/pages/devedores.html" },
    { "source": "/metas", "destination": "/pages/metas.html" },
    { "source": "/cartoes", "destination": "/pages/cartoes.html" },
    { "source": "/relatorios", "destination": "/pages/relatorios.html" },
    { "source": "/configuracoes", "destination": "/pages/configuracoes.html" }
  ]
}
