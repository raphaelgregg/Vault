{
  "name": "vault-finance",
  "version": "0.2.0",
  "private": true,
  "description": "Controle financeiro pessoal — HTML/CSS/JS puro + Firebase (Fase 2: fundação)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test \"tests/model/*.test.mjs\" \"tests/services/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-vault-finance \"node --test tests/rules/*.test.mjs\"",
    "serve": "npx http-server -p 5500 -c-1 .",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-vault-finance \"node tests/e2e/flows.mjs\"",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.23.1"
  }
}
